### mix test / git write commands in bench scripts
bench/run.sh:28:# explicitly for every command and cleared otherwise); `mix test` is never run; git is never run except a read-only
### default workspace references in bench scripts
bench/run.sh:27:# Guarantees: the default workspace (~/.local/share/harnessforge) is never used (HARNESSFORGE_WORKSPACE is set
bench/run.sh:258:  "${HOME:-/nonexistent}/.local/share/harnessforge"*) die "BENCH_TMP_ROOT must not point at the default workspace tree: $TMP_ROOT" ;;
### run.sh: where it writes (BENCH_OUT_ROOT default and rerun guard)
15:#   BENCH_OUT_ROOT         evidence root; default docs/benchmarks/$(date +%F) under the repository. If that default
16:#                          already holds a README.md (a published evidence set), the run writes to
17:#                          docs/benchmarks/<date>-rerun-<UTC time> instead of overwriting it.
33:# Output layout under BENCH_OUT_ROOT:
53:TODAY=$(date +%F)
231:OUT_ROOT=${BENCH_OUT_ROOT:-}
234:  if [ -f "$OUT_ROOT/README.md" ]; then
235:    OUT_ROOT=$PROJECT/docs/benchmarks/$TODAY-rerun-$(date -u +%H%M%S)
### run.sh: stage names and tmp cleanup
18:#   BENCH_TMP_ROOT         scratch root for workspaces, exports and corpus copies; default tmp/bench-<UTC timestamp>
21:#   BENCH_STAGES           comma-separated subset of e2e-browser,e2e-cli,pipeline,portal (default: all four).
22:#   BENCH_KEEP_TMP=1       keep the default scratch root even after a successful run.
55:STAGES=${BENCH_STAGES:-e2e-browser,e2e-cli,pipeline,portal}
56:KEEP_TMP=${BENCH_KEEP_TMP:-0}
202:skip_stage() { log "=== stage $1: skipped (BENCH_STAGES=$STAGES)"; }
210:      rm -rf "$TMP_ROOT"
247:if [ -n "${BENCH_TMP_ROOT:-}" ]; then
248:  TMP_ROOT=$BENCH_TMP_ROOT
255:  *) die "BENCH_TMP_ROOT must be an absolute path: $TMP_ROOT" ;;
258:  "${HOME:-/nonexistent}/.local/share/harnessforge"*) die "BENCH_TMP_ROOT must not point at the default workspace tree: $TMP_ROOT" ;;
