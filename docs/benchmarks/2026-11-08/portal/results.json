  "commands": [
    {
      "name": "server start (background)",
      "command": "cd <repo> && perl -MTime::HiRes=time -e 'printf(\"%.3f\\n\", time)' > <repo>/docs/benchmarks/2026-11-08/portal/server-start-epoch.txt && date -u +%Y-%m-%dT%H:%M:%SZ > <repo>/docs/benchmarks/2026-11-08/portal/server-start-iso.txt && PORT=8866 HARNESSFORGE_WORKSPACE=<scratch>/portal-ws PHX_SERVER=true mix phx.server > <repo>/docs/benchmarks/2026-11-08/portal/server.log 2>&1"
    },
    {
      "name": "readiness poll",
      "command": "every 0.1 s: curl -s -o /dev/null -w '%{http_code}' --max-time 1 http://127.0.0.1:8866/  until the code is not 000; ready time = perl Time::HiRes time at that moment"
    },
    {
      "name": "server RSS",
      "command": "pid=$(lsof -ti :8866 | head -1); ps -o comm= -p $pid; ps -o rss= -p $pid   (rss in KiB)"
    },
    {
      "name": "browser flow",
      "command": "cd <repo> && HARNESSFORGE_URL=http://127.0.0.1:8866 HARNESSFORGE_WORKSPACE=<scratch>/portal-ws BENCH_OUT=<repo>/docs/benchmarks/2026-11-08/portal node bench/portal.cjs"
    },
    {
      "name": "curl probes",
      "command": "curl -s -o /dev/null -w '%{http_code} %{size_download} %{time_starttransfer}' http://127.0.0.1:8866/   and   .../login   (5 each per instance)"
    },
    {
      "name": "server stop",
      "command": "kill $(lsof -ti :8866); poll every 0.1 s until kill -0 fails and lsof -ti :8866 is empty"
    },
    {
      "name": "timed restarts",
      "command": "in one shell: start stamp; PORT=8866 HARNESSFORGE_WORKSPACE=<ws> PHX_SERVER=true mix phx.server > server-restart-<label>.log 2>&1 &; readiness poll as above; ps rss of the beam pid; kill; wait until gone. 3 cycles on the existing workspace (warm1-3) and 3 on new empty workspaces (fresh1-3)"
    },
    {
      "name": "machine facts",
      "command": "git rev-parse HEAD; git status --porcelain | wc -l; sysctl -n machdep.cpu.brand_string hw.logicalcpu hw.memsize vm.loadavg; sw_vers; uname -r; node --version; elixir --version; erl -noshell -eval erlang:system_info(otp_release)"
    }
  ],
