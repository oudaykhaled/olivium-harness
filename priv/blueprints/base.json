  "agent": {
    "name": "olivium-implementer",
    "description": "Implements one scoped change in this repository and verifies it with the project's own checks.",
    "requires": [
      "commands.test"
    ],
    "instructions": [
      "Make the requested change with the smallest diff that works, in the style of the surrounding code.",
      "",
      "- Read the code you will change and its tests first.",
      "- Add or update a test when behaviour changes.",
      "- For one test: `{{commands.test_single}}`",
      "- Before finishing: `{{commands.test}}`",
      "- Lint: `{{commands.lint}}`",
      "- Report what changed and the exact check results."
    ]
  },
  "skill": {
    "name": "olivium-run-checks",
    "description": "Run this project's lint, type and test checks after a change and report the results.",
    "requires": [
      "commands.test"
    ],
    "instructions": [
      "Run these in order. Stop at the first failure, fix it, and rerun.",
      "",
      "- Lint: `{{commands.lint}}`",
      "- Types: `{{commands.typecheck}}`",
      "- Tests: `{{commands.test}}`"
    ]
  },
