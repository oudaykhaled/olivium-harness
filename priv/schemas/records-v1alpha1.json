{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnessforge.dev/schemas/records-v1alpha1.json",
  "title": "HarnessForge immutable records v1alpha1",
  "oneOf": [
    {
      "$ref": "#/$defs/source_revision"
    },
    {
      "$ref": "#/$defs/claim_revision"
    },
    {
      "$ref": "#/$defs/rule_decision"
    },
    {
      "$ref": "#/$defs/goal_revision"
    },
    {
      "$ref": "#/$defs/capability_report"
    },
    {
      "$ref": "#/$defs/artifact"
    },
    {
      "$ref": "#/$defs/evaluation_result"
    },
    {
      "$ref": "#/$defs/release_approval"
    },
    {
      "$ref": "#/$defs/channel_assignment"
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision_id": {
          "$ref": "#/$defs/uuid"
        },
        "start_byte": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000000
        },
        "end_byte": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000000
        },
        "snippet_hash": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "revision_id",
        "start_byte",
        "end_byte",
        "snippet_hash"
      ]
    },
    "source_revision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "item_id": {
          "$ref": "#/$defs/uuid"
        },
        "original_digest": {
          "$ref": "#/$defs/digest"
        },
        "normalized_digest": {
          "$ref": "#/$defs/digest"
        },
        "snapshot_digest": {
          "$ref": "#/$defs/digest"
        },
        "updated_at": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "access_state": {
          "type": "string",
          "enum": [
            "current",
            "stale",
            "revoked",
            "unknown"
          ]
        },
        "normalizer_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "item_id",
        "original_digest",
        "normalized_digest",
        "snapshot_digest",
        "updated_at",
        "observed_at",
        "access_state",
        "normalizer_version"
      ]
    },
    "claim_revision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "claim_id": {
          "$ref": "#/$defs/uuid"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "rationale_kind": {
          "type": "string",
          "enum": [
            "historical_evidence",
            "future_goal"
          ]
        },
        "citations": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "goal_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "content_digest": {
          "$ref": "#/$defs/digest"
        },
        "conflict_ids": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/uuid"
          }
        }
      },
      "required": [
        "id",
        "claim_id",
        "statement",
        "rationale_kind",
        "citations",
        "goal_id",
        "content_digest",
        "conflict_ids"
      ]
    },
    "rule_decision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "claim_revision_id": {
          "$ref": "#/$defs/uuid"
        },
        "claim_digest": {
          "$ref": "#/$defs/digest"
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "action": {
          "type": "string",
          "enum": [
            "approve",
            "reject"
          ]
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "decided_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      },
      "required": [
        "id",
        "claim_revision_id",
        "claim_digest",
        "actor",
        "action",
        "notes",
        "decided_at"
      ]
    },
    "goal_revision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "goal_id": {
          "$ref": "#/$defs/uuid"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "current_state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "target_state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "constraints": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "dependencies": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/uuid"
          }
        },
        "content_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "id",
        "goal_id",
        "owner",
        "current_state",
        "target_state",
        "constraints",
        "acceptance",
        "dependencies",
        "content_digest"
      ]
    },
    "capability_report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "required": {
          "type": "boolean"
        },
        "requested_value": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            }
          ]
        },
        "mapping_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "enum": [
            "supported_runtime",
            "enforced_external",
            "advisory",
            "unsupported"
          ]
        },
        "enforcement_boundary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "environment_profile_digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "compatibility_test_reference": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ]
        },
        "diagnostics": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        }
      },
      "required": [
        "id",
        "required",
        "requested_value",
        "mapping_version",
        "status",
        "enforcement_boundary",
        "environment_profile_digest",
        "compatibility_test_reference",
        "diagnostics"
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "payload_digest": {
          "$ref": "#/$defs/digest"
        },
        "canonical_spec_digest": {
          "$ref": "#/$defs/digest"
        },
        "adapter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "manifest_digest": {
          "$ref": "#/$defs/digest"
        },
        "capability_report_digest": {
          "$ref": "#/$defs/digest"
        },
        "state": {
          "type": "string",
          "enum": [
            "preview",
            "generated",
            "restricted",
            "revoked"
          ]
        }
      },
      "required": [
        "id",
        "payload_digest",
        "canonical_spec_digest",
        "adapter",
        "adapter_version",
        "manifest_digest",
        "capability_report_digest",
        "state"
      ]
    },
    "evaluation_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "artifact_digest": {
          "$ref": "#/$defs/digest"
        },
        "suite_digest": {
          "$ref": "#/$defs/digest"
        },
        "environment_digest": {
          "$ref": "#/$defs/digest"
        },
        "runtime_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "blocked",
            "cancelled",
            "timed_out",
            "interrupted",
            "inconclusive"
          ]
        },
        "cleanup_status": {
          "type": "string",
          "enum": [
            "not_started",
            "complete",
            "cleanup_failed"
          ]
        },
        "case_results": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "status": {
                "type": "string",
                "enum": [
                  "passed",
                  "failed",
                  "blocked",
                  "cancelled",
                  "timed_out",
                  "interrupted",
                  "inconclusive"
                ]
              },
              "duration_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 86400000
              },
              "grader_digest": {
                "$ref": "#/$defs/digest"
              }
            },
            "required": [
              "id",
              "status",
              "duration_ms",
              "grader_digest"
            ]
          }
        }
      },
      "required": [
        "id",
        "artifact_digest",
        "suite_digest",
        "environment_digest",
        "runtime_version",
        "status",
        "cleanup_status",
        "case_results"
      ]
    },
    "release_approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "artifact_digest": {
          "$ref": "#/$defs/digest"
        },
        "evaluation_id": {
          "$ref": "#/$defs/uuid"
        },
        "capability_report_digest": {
          "$ref": "#/$defs/digest"
        },
        "scope_digest": {
          "$ref": "#/$defs/digest"
        },
        "policy_digest": {
          "$ref": "#/$defs/digest"
        },
        "environment_digest": {
          "$ref": "#/$defs/digest"
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "approved_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      },
      "required": [
        "id",
        "artifact_digest",
        "evaluation_id",
        "capability_report_digest",
        "scope_digest",
        "policy_digest",
        "environment_digest",
        "actor",
        "approved_at"
      ]
    },
    "channel_assignment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "workspace_id": {
          "$ref": "#/$defs/uuid"
        },
        "scope_digest": {
          "$ref": "#/$defs/digest"
        },
        "channel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "artifact_digest": {
          "$ref": "#/$defs/digest"
        },
        "expected_previous_digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "release_approval_id": {
          "$ref": "#/$defs/uuid"
        },
        "assigned_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      },
      "required": [
        "id",
        "workspace_id",
        "scope_digest",
        "channel",
        "artifact_digest",
        "expected_previous_digest",
        "release_approval_id",
        "assigned_at"
      ]
    }
  }
}
