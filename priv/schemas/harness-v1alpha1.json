{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnessforge.dev/schemas/harness-v1alpha1.json",
  "title": "HarnessForge Harness v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "harnessforge.dev/v1alpha1",
      "type": "string"
    },
    "kind": {
      "const": "Harness",
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "required": [
            "name",
            "version"
          ]
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repositories": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "minItems": 0,
              "maxItems": 100,
              "uniqueItems": true
            }
          },
          "required": [
            "repositories"
          ]
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          },
          "minItems": 0,
          "maxItems": 500
        },
        "goals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/goal"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "policies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/policy"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/agent"
          },
          "minItems": 1,
          "maxItems": 32
        },
        "skills": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/skill"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_turns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            }
          },
          "required": [
            "max_turns",
            "timeout_seconds"
          ]
        },
        "evaluation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "suite": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9_-]*$"
            }
          },
          "required": [
            "suite"
          ]
        }
      },
      "required": [
        "runtime",
        "scope",
        "rules",
        "goals",
        "policies",
        "agents",
        "skills",
        "execution",
        "evaluation"
      ]
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision_id": {
          "$ref": "#/$defs/uuid"
        },
        "start_byte": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000000
        },
        "end_byte": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000000
        },
        "snippet_hash": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "revision_id",
        "start_byte",
        "end_byte",
        "snippet_hash"
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "revision_hash": {
          "$ref": "#/$defs/digest"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          },
          "minItems": 0,
          "maxItems": 32
        },
        "goal_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 36,
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "revision_hash",
        "statement",
        "evidence",
        "goal_id"
      ]
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "acceptance": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "minItems": 1,
          "maxItems": 32
        }
      },
      "required": [
        "id",
        "owner",
        "statement",
        "acceptance"
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "required": {
          "type": "boolean"
        },
        "capability": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          ]
        }
      },
      "required": [
        "id",
        "required",
        "capability",
        "value"
      ]
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        }
      },
      "required": [
        "name",
        "description",
        "instructions"
      ]
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        }
      },
      "required": [
        "name",
        "description",
        "instructions"
      ]
    }
  }
}
