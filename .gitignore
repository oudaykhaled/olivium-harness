# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
harness_forge-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/

# Database files
*.db
*.db-*

# Local workspaces, test staging, exports and runtime caches.
/tmp/
/.evidence-test-*/
/.portal-test-*/
/data/
/.local-tools/
/test/browser/node_modules/
/test/browser/results/
# Generated release notices and dependency inventory staging.
/rel/overlays/share/

# Local credentials and runtime/evidence outputs are never source files.
.env
.env.*
!.env.example
!.env.sample
*.sqlite3
*.sqlite3-*
*.sqlite
*.sqlite-*
/output/
/.DS_Store
**/.DS_Store
**/__pycache__/
*.pyc

# Authenticated local showcase recordings are distributed separately.
/priv/showcase/*.webm
/priv/showcase/*.mp4

# The website source lives in the oudaykhaled/olivium-harness-site repository.
/website/

# Benchmark export scratch folders (default E2E_EXPORT_ROOT).
/docs/benchmarks/*/tmp-exports/
